# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview  # or gpt-3.5-turbo for cost saving

# Anthropic API Configuration (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Evolution Algorithm Parameters
POPULATION_SIZE=50
GENERATIONS=100
MUTATION_RATE=0.1
CROSSOVER_RATE=0.7

# Evaluation Settings
MAX_WORKERS=4           # Parallel evaluation workers
TIMEOUT_SECONDS=30      # SQL execution timeout
VALIDATION_SPLIT=0.2    # Validation set ratio

# Paths
DATA_DIR=./data
RESULTS_DIR=./results
LOGS_DIR=./logs

# Debug
DEBUG=False
VERBOSE=True
